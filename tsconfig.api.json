{
  "extends": "@tsconfig/node22/tsconfig.json",
  "include": ["api/**/*"],
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.api.tsbuildinfo",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": ".vercel/output",
    "rootDir": ".",
    "allowImportingTsExtensions": false,
    "types": ["node"]
  }
}
